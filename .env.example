# Copy this file to .env.local for local development, and set the same
# names as environment variables on your production host (e.g. Hostinger).
# Never commit actual values — .env.local and .env* are gitignored.

# --- MySQL connection (staff/admin portal + messaging) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Staff/admin session signing ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a DIFFERENT value in production than in local dev.
STAFF_SESSION_SECRET=

# --- Stripe checkout ---
# Test mode keys while validating the full flow; switch to live keys only
# once the test plan in the Stripe integration brief has fully passed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set after the webhook route is deployed and registered in the Stripe
# Dashboard (Developers > Webhooks > Add endpoint), from the signing
# secret Stripe gives you for that endpoint.
STRIPE_WEBHOOK_SECRET=

# Temporary switch for eSIM sales. Checkout is PAUSED unless this is
# exactly "true" (customers see an "eSIM orders are temporarily
# unavailable" message). Set it to true in Hostinger and redeploy to resume.
ESIM_CHECKOUT_ENABLED=
# Stripe test-mode orders (cs_test_ sessions) never get a real eSIM unless
# this is exactly "true" — provisioning buys a real plan from Transatel and
# Stripe's test cards are public. Only set it for a deliberate end-to-end
# test, and unset it straight after. (Admin "Retry" never works on test
# orders either way.)
ESIM_PROVISION_TEST_ORDERS=

# --- Email (Resend) ---
# API key with "Sending access" (Resend dashboard > API Keys). The From
# address's domain must be verified in Resend (Domains > Add domain, EU
# region), with the DNS records Resend lists added at your DNS host.
RESEND_API_KEY=
EMAIL_FROM=SpeedNetRDC <orders@speednetrdc.com>
# Inbox that receives customer replies (Resend only sends mail).
EMAIL_REPLY_TO=

# --- App URL (Stripe success/cancel redirects and links in emails) ---
APP_URL=http://localhost:3000

# --- Transatel (Service Provider Connect / OCS) eSIM provisioning ---
# OAuth2 client credentials issued by Transatel for API access.
TRANSATEL_API_LOGIN=
TRANSATEL_API_PASSWORD=
# Class of Service for this account (verified with npm run transatel:check;
# "COS_SPC" is refused). Only used for catalog lookups.
TRANSATEL_COS=WW_M2MA_COS_SPC
# MVNO reference for this account, required when placing an order.
TRANSATEL_MVNO_REF=M2MA_WW_TSL_SPEEDNETRDC
# Not needed: Service Provider Connect SIMs arrive pre-activated, so we never
# call the activation API that used it. (Ours is M2MA_WW_TSL_BUNDLES_1, only
# relevant to Transatel's optional Subscription Management API.)
# TRANSATEL_RATE_PLAN=
# Optional events webhook: a secret you choose and enter in the Transatel
# Console (Data Stream tab) when registering
#   https://<your-domain>/api/transatel/events
# Transatel signs each event with it; events with a bad signature are
# rejected. Generate one the same way as STAFF_SESSION_SECRET above.
TRANSATEL_EVENTS_SECRET=
# Base URL for Transatel's API gateway. Leave unset to use Transatel's
# default (https://api.transatel.com) — only override if Transatel gives
# you a different gateway URL for your account.
TRANSATEL_API_BASE_URL=
