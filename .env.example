# Copy this file to .env.local for local development, and set the same
# names as environment variables on your production host (e.g. Hostinger).
# Never commit actual values — .env.local and .env* are gitignored.

# --- MySQL connection (staff/admin portal + messaging) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Staff/admin session signing ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a DIFFERENT value in production than in local dev.
STAFF_SESSION_SECRET=

# --- One-time admin bootstrap (see /setup-admin) ---
# Only needed until you've created your first admin account, then remove
# both this variable and the /setup-admin route.
SETUP_ADMIN_SECRET=

# --- Stripe checkout ---
# Test mode keys while validating the full flow; switch to live keys only
# once the test plan in the Stripe integration brief has fully passed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set after the webhook route is deployed and registered in the Stripe
# Dashboard (Developers > Webhooks > Add endpoint), from the signing
# secret Stripe gives you for that endpoint.
STRIPE_WEBHOOK_SECRET=

# --- App URL (used to build Stripe success/cancel redirect URLs) ---
APP_URL=http://localhost:3000

# --- Transatel (Service Provider Connect / OCS) eSIM provisioning ---
# OAuth2 client credentials issued by Transatel for API access. Use the
# DEMO account's values while testing, and only switch to the production
# account's values once the demo test order has been verified end-to-end.
TRANSATEL_API_LOGIN=
TRANSATEL_API_PASSWORD=
# Class of Service for this account — confirmed by Transatel support.
TRANSATEL_COS=WW_M2MA_COS_SPC
# MVNO reference for this account, required when placing an order.
TRANSATEL_MVNO_REF=
# Base connectivity rate plan for this account (from Transatel at contract
# signature) — required to activate a brand-new, never-used SIM. Ask your
# Transatel contact for this if you don't have it; it's not in any catalog
# file. Different from the per-customer data plan (that's the Plan.id /
# productId, already in src/data/generated/plans.json).
TRANSATEL_RATE_PLAN=
# Shared secret you choose yourself and register as part of the webhook
# URL in Transatel's Console (Data Stream tab) for the
# CONNECTIVITY-MANAGEMENT/SUBSCRIBER/ACTIVATED event:
#   https://<your-domain>/api/transatel/events?token=<this value>
# Generate one the same way as STAFF_SESSION_SECRET above.
TRANSATEL_EVENTS_SECRET=
# Base URL for Transatel's API gateway. Leave unset to use Transatel's
# default (https://api.transatel.com) — only override if Transatel gives
# you a different gateway URL for your account.
TRANSATEL_API_BASE_URL=
