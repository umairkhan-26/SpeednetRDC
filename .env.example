# Copy this file to .env.local for local development, and set the same
# names as environment variables on your production host (e.g. Hostinger).
# Never commit actual values — .env.local and .env* are gitignored.

# --- MySQL connection (staff/admin portal + messaging) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Staff/admin session signing ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a DIFFERENT value in production than in local dev. Also keys the
# hashes used for sign-in rate limiting (IP addresses are never stored raw).
STAFF_SESSION_SECRET=

# --- Customer sign-in ("My eSIMs") ---
# Signs the 30-day customer session cookie set after an emailed sign-in
# link. A long random string, different from STAFF_SESSION_SECRET
# (generate it the same way).
CUSTOMER_SESSION_SECRET=

# --- Stripe checkout ---
# Test mode keys while validating the full flow; switch to live keys only
# once the test plan in the Stripe integration brief has fully passed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Set after the webhook route is deployed and registered in the Stripe
# Dashboard (Developers > Webhooks > Add endpoint), from the signing
# secret Stripe gives you for that endpoint.
STRIPE_WEBHOOK_SECRET=

# Temporary switch for eSIM sales. Checkout is PAUSED unless this is
# exactly "true" (customers see an "eSIM orders are temporarily
# unavailable" message). Set it to true in Hostinger and redeploy to resume.
ESIM_CHECKOUT_ENABLED=
# Stripe test-mode orders (cs_test_ sessions) never get a real eSIM unless
# this is exactly "true" — provisioning buys a real plan from Transatel and
# Stripe's test cards are public. Only set it for a deliberate end-to-end
# test, and unset it straight after. (Admin "Retry" never works on test
# orders either way.)
ESIM_PROVISION_TEST_ORDERS=

# --- Physical SIM cards + "Add to my SIM" top-ups ---
# OFF unless this is exactly "true": the card checkout on /physical-sim,
# "Add to my SIM" on plan pages, My SIMs and the Shipping list. While off,
# /physical-sim still shows the card, ordered by email. Redeploy after
# changing it. Placeholders still to confirm: src/lib/physical-sim.ts
# (PENDING_ANSWERS).
PHYSICAL_SIM_ENABLED=

# --- Recharge ("Add to my SIM") for eSIM customers ---
# OFF unless this is exactly "true". Shows "Add to my SIM" on plan pages, the
# "Recharge" button in My SIMs, the "How to recharge" help/FAQ/order-page texts,
# and lets the checkout accept top-ups. Independent of PHYSICAL_SIM_ENABLED
# (turning that on also keeps recharge available). Redeploy after changing it.
# Try one real recharge yourself before turning it on for everyone.
TOPUP_ENABLED=
# How tax applies to the card (€10, 1 GB included) and worldwide shipping (€5):
#   final (default) = €15.00 all-in, VAT included (the client's offer) ·
#   vat = +21% on top = €18.15 · surcharge = +5% "taxes & fees" = €15.75
PHYSICAL_SIM_TAX_MODE=final
# The data plan put on every card when it's shipped (a plan id from the
# catalogue). Default: Global 1 GB / 30 days (184 countries).
PHYSICAL_SIM_INCLUDED_PLAN=
# What one blank SIM card costs us, in euros (e.g. 1.80). Used only for the
# admin profit figures: a shipped card's cost = this + the included plan's
# cost + the postage typed when marking it shipped. Empty = "cost unknown"
# (those orders are counted in the dashboard's "orders without cost" warning).
SIM_CARD_COST_EUR=

# --- Email (Resend) ---
# API key with "Sending access" (Resend dashboard > API Keys). The From
# address's domain must be verified in Resend (Domains > Add domain, EU
# region), with the DNS records Resend lists added at your DNS host.
RESEND_API_KEY=
EMAIL_FROM=SpeedNetRDC <orders@speednetrdc.com>
# Inbox that receives customer replies (Resend only sends mail).
EMAIL_REPLY_TO=

# --- Meta (Facebook) Pixel and Conversions API ---
# Pixel ID from Meta Events Manager. Built into the pages, so set it before
# deploying. Leave empty to turn the Pixel and the cookie banner off. The
# Pixel only loads after a visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (Events Manager > your Pixel > Settings >
# Conversions API > Generate access token). Server-only: never commit it,
# never put it in a NEXT_PUBLIC_ variable, never paste it in chat or logs.
# Without it, no server-side Purchase events are sent.
META_CAPI_TOKEN=
# Optional: the "Test events" code from Events Manager. Only Stripe
# test-mode orders are sent with it (live orders never are), so you can see
# test purchases arrive without counting them.
META_CAPI_TEST_EVENT_CODE=
# Optional: Graph API version for the Conversions API (default v26.0).
META_GRAPH_API_VERSION=

# --- Google Analytics / Google Ads and TikTok ---
# Optional, each off while empty. Like the Meta Pixel ID they are built into
# the pages (set them, then redeploy so the site is rebuilt), and nothing loads
# until a visitor accepts the cookie banner, which then names them, as does the
# Privacy Policy.
# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
# Google Ads tag ID (AW-123456789).
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label of the Google Ads "Purchase" conversion action: the part after the
# slash in send_to ("AW-123456789/AbC-D_efG123"). Without it no Google Ads
# conversion is sent.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# TikTok Pixel ID (TikTok Ads Manager > Events).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- App URL (Stripe success/cancel redirects and links in emails) ---
APP_URL=http://localhost:3000

# --- Transatel (Service Provider Connect / OCS) eSIM provisioning ---
# OAuth2 client credentials issued by Transatel for API access.
TRANSATEL_API_LOGIN=
TRANSATEL_API_PASSWORD=
# Class of Service for this account (verified with npm run transatel:check;
# "COS_SPC" is refused). Only used for catalog lookups.
TRANSATEL_COS=WW_M2MA_COS_SPC
# MVNO reference for this account, required when placing an order.
TRANSATEL_MVNO_REF=M2MA_WW_TSL_SPEEDNETRDC
# Not needed: Service Provider Connect SIMs arrive pre-activated, so we never
# call the activation API that used it. (Ours is M2MA_WW_TSL_BUNDLES_1, only
# relevant to Transatel's optional Subscription Management API.)
# TRANSATEL_RATE_PLAN=
# Optional events webhook: a secret you choose and enter in the Transatel
# Console (Data Stream tab) when registering
#   https://<your-domain>/api/transatel/events
# Transatel signs each event with it; events with a bad signature are
# rejected. Generate one the same way as STAFF_SESSION_SECRET above.
TRANSATEL_EVENTS_SECRET=
# Base URL for Transatel's API gateway. Leave unset to use Transatel's
# default (https://api.transatel.com) — only override if Transatel gives
# you a different gateway URL for your account.
TRANSATEL_API_BASE_URL=
