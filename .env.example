# Copy this file to .env.local for local development, and set the same
# names as environment variables on your production host (e.g. Hostinger).
# Never commit actual values — .env.local and .env* are gitignored.

# --- MySQL connection (staff/admin portal + messaging) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Staff/admin session signing ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a DIFFERENT value in production than in local dev.
STAFF_SESSION_SECRET=

# --- One-time admin bootstrap (see /setup-admin) ---
# Only needed until you've created your first admin account, then remove
# both this variable and the /setup-admin route.
SETUP_ADMIN_SECRET=
